# =============================================================================
# LLM-Powered Workflow Engine — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# See docs/configuration.md for full reference.

# --- Environment ---
ENVIRONMENT=dev                    # dev | staging | production
DEBUG=false

# --- Google AI / LLM ---
GOOGLE_API_KEY=your-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE
LLM_MODEL=gemini-2.5-flash
# LLM_TEMPERATURE=0.7
# LLM_TOP_P=0.9
# LLM_TOP_K=40
# LLM_MAX_OUTPUT_TOKENS=8192

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///data/workflow.db
REFERENCE_DATA_DATABASE_URL=sqlite+aiosqlite:///data/workflow.db
SEED_REFERENCE_DATA=true
ADK_SESSION_DATABASE_URL=sqlite+aiosqlite:///data/adk_sessions_v2.db
POLICY_DATABASE_URL=sqlite+aiosqlite:///data/workflow.db
# CORE_STORE_ADAPTER_FACTORY=your_package.adapters:create_core_store
# POLICY_REPOSITORY_ADAPTER_FACTORY=your_package.adapters:create_policy_repository
# For PostgreSQL in production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/workflow

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:8001","http://localhost:3000"]

# --- Shiny development/operator console ---
BACKEND_URL=http://localhost:8000
# BACKEND_AUTH_TOKEN=short-lived-operator-token

# --- Authentication (disabled by default for dev) ---
AUTH_ENABLED=false
# AUTH_SECRET_KEY=change-me-in-production
# AUTH_TOKEN_EXPIRE_MINUTES=480

# --- Policy governance ---
JURISDICTION_PROFILE=NAM
# JURISDICTION_CONFIG_PATH=config/jurisdictions.yaml
# JURISDICTION_ENFORCE=false       # defaults false in dev, true elsewhere
POLICY_SIGNING_KEY=dev-policy-signing-key
POLICY_SIGNING_KEY_ID=primary
# POLICY_VERIFICATION_KEYS={"retired-key-2025":"secret-manager-old-key-value"}
POLICY_AUTHOR=operations-author
POLICY_APPROVER=risk-approver

# --- Upstream provider adapters ---
# Unset defaults to sandbox in dev and disabled elsewhere.
# UPSTREAM_MODE=sandbox            # disabled | sandbox | provider
# PROVIDER_BUNDLE_FACTORY=your_package.providers:create_bundle
SANDBOX_DATABASE_URL=sqlite+aiosqlite:///data/upstream_sandbox.db
ACTION_WORKER_LEASE_SECONDS=30
ACTION_RECONCILIATION_DELAY_SECONDS=30

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=false
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW_SECONDS=60

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=text                    # text (dev) | json (production)
# LOG_FILE=/var/log/workflow-engine/app.log
